CF_ACCOUNT_ID=your_cloudflare_account_id
CF_D1_ID=your_d1_database_id
CF_API_TOKEN=your_cloudflare_api_token
GEMINI_API_KEY=your_gemini_api_key
# Optional alias — generator also maps GEMINI_API_KEY → GOOGLE_API_KEY
# GOOGLE_API_KEY=your_gemini_api_key
TYPESAFE_API_KEY=your_typesafe_api_key
AUTO_APPROVE=0

# Optional model override (default gemini-3.5-flash; gemini-2.0-flash is retired)
# GEMINI_MODEL=gemini-3.5-flash
# POOL_TARGET=40

# Rebuild today's 14-day daily buffer from scratch:
#   AUTO_APPROVE=1 python generator.py --reset-daily --daily-only
# CF_API_TOKEN needs Account → D1 → Edit. Otherwise apply SQL via:
#   npx wrangler d1 execute daily-subtle-lie --remote --file=regen-dailies.sql

# Web app (Cloudflare Worker secrets + web/.dev.vars) for Choose-a-topic LLM:
# ADMIN_TOKEN=long-random-string
# GEMINI_API_KEY=your_gemini_api_key
# TYPESAFE_API_KEY=your_typesafe_api_key
# Optional CI Slack webhook (GitHub Actions secret):
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...




